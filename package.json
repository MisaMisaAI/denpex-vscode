{
  "name": "denpex-diagnostics",
  "displayName": "Denpex: GPU, CUDA & PyTorch ML Crash Diagnostics",
  "description": "Diagnose GPU errors, CUDA OOM, PyTorch crashes, NCCL hangs, Xid, Slurm and vLLM failures in VS Code. Free offline analysis. No sign-up.",
  "version": "1.4.42",
  "publisher": "denpex",
  "icon": "logo.png",
  "pricing": "Free",
  "license": "SEE LICENSE IN LICENSE.txt",
  "qna": "marketplace",
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "badges": [
    {
      "url": "https://img.shields.io/badge/Offline%20Engine-100%25%20Local-success",
      "href": "https://denpex.com/vscode",
      "description": "Offline Engine"
    },
    {
      "url": "https://img.shields.io/badge/Privacy-Zero%20Code%20Upload-blue",
      "href": "https://denpex.com/privacy",
      "description": "Privacy Guarantee"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MisaMisaAI/denpex-vscode.git"
  },
  "homepage": "https://denpex.com/vscode",
  "bugs": {
    "url": "https://github.com/MisaMisaAI/denpex-vscode/issues",
    "email": "support@denpex.com"
  },
  "galleryBanner": {
    "color": "#151515",
    "theme": "dark"
  },
  "keywords": [
    "gpu",
    "cuda",
    "pytorch",
    "torchrun",
    "cuda-oom",
    "cuda-error",
    "nccl",
    "xid",
    "xid-errors",
    "slurm",
    "vllm",
    "deepspeed",
    "sglang",
    "megatron",
    "infiniband",
    "nvidia-smi",
    "hpc",
    "h100",
    "a100",
    "b200",
    "multi-gpu",
    "distributed-training",
    "gpu-memory",
    "gpu-debugging",
    "ai-debugger",
    "llm-debugging",
    "fine-tuning",
    "fsdp",
    "ddp",
    "nvlink"
  ],
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Machine Learning",
    "Debuggers",
    "Data Science"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "denpex.cloudHistory",
        "title": "Denpex: Shared Cloud History"
      },
      {
        "command": "denpex.inspectGpuArtifact",
        "title": "Denpex: Inspect GPU Artifact Locally"
      },
      {
        "command": "denpex.connectAccount",
        "title": "Denpex: Connect Account"
      },
      {
        "command": "denpex.disconnectAccount",
        "title": "Denpex: Disconnect Account"
      },
      {
        "command": "denpex.diagnoseCurrentLogs",
        "title": "Denpex: Diagnose Current Logs",
        "icon": {
          "light": "media/diagnose-light.svg",
          "dark": "media/diagnose-dark.svg"
        }
      },
      {
        "command": "denpex.diagnoseSelection",
        "title": "Diagnose GPU/ML Error"
      },
      {
        "command": "denpex.diagnoseCurrentEditor",
        "title": "Denpex: Diagnose Current Log",
        "icon": {
          "light": "media/diagnose-light.svg",
          "dark": "media/diagnose-dark.svg"
        }
      },
      {
        "command": "denpex.diagnoseLastFailure",
        "title": "Diagnose Last Failure"
      },
      {
        "command": "denpex.diagnoseTerminal",
        "title": "Denpex: Diagnose Terminal Error"
      },
      {
        "command": "denpex.diagnoseAllTerminals",
        "title": "Denpex: Diagnose Across All Terminals (Multi-Node)"
      },
      {
        "command": "denpex.diagnoseCloud",
        "title": "Denpex: Deep Reasoning (Cloud) on Last Diagnosis"
      },
      {
        "command": "denpex.runSample",
        "title": "Denpex: Choose a Sample Failure"
      },
      {
        "command": "denpex.sample.ncclOom",
        "title": "Denpex Sample: Rank-local OOM → NCCL Cascade"
      },
      {
        "command": "denpex.sample.xid79",
        "title": "Denpex Sample: Xid 79 GPU Fallen Off Bus"
      },
      {
        "command": "denpex.sample.interfaceMismatch",
        "title": "Denpex Sample: NCCL Interface Mismatch"
      },
      {
        "command": "denpex.sample.kubernetesPlugin",
        "title": "Denpex Sample: Kubernetes Device-plugin Health"
      },
      {
        "command": "denpex.sample.vllmKvCache",
        "title": "Denpex Sample: vLLM KV-cache Exhaustion"
      },
      {
        "command": "denpex.walkthrough.inspectCausality",
        "title": "Denpex: Show Initiating Rank and Collateral Victims"
      },
      {
        "command": "denpex.walkthrough.inspectFix",
        "title": "Denpex: Show Fix and Verification Command"
      },
      {
        "command": "denpex.showPrivacyStatus",
        "title": "Denpex: Show Local/Offline Privacy Status"
      },
      {
        "command": "denpex.manageAnalytics",
        "title": "Denpex: Manage Anonymous Step Counts"
      },
      {
        "command": "denpex.startTrial",
        "title": "Denpex: Request Optional 30-day Team Trial"
      },
      {
        "command": "denpex.generateRma",
        "title": "Denpex: Generate Hardware RMA Payload"
      },
      {
        "command": "denpex.setApiKey",
        "title": "Denpex: Set API Key"
      },
      {
        "command": "denpex.redeemCode",
        "title": "Denpex: Redeem Trial Code"
      },
      {
        "command": "denpex.openPricing",
        "title": "Denpex: View Pricing / Upgrade"
      },
      {
        "command": "denpex.openDashboard",
        "title": "Denpex: Open Cloud Dashboard"
      },
      {
        "command": "denpex.startInEditorTrial",
        "title": "Denpex: Request 30-Day Team Trial Code"
      },
      {
        "command": "denpex.copyIncidentReport",
        "title": "Denpex: Copy Post-Mortem Incident Report (Slack / PR)"
      },
      {
        "command": "denpex.diagnoseClipboard",
        "title": "Denpex: Paste & Diagnose Clipboard"
      },
      {
        "command": "denpex.scanClusterLogs",
        "title": "Denpex: Scan Workspace for Slurm/GPU Cluster Logs"
      },
      {
        "command": "denpex.showStatusBarMenu",
        "title": "Denpex: Quick Diagnostics Menu"
      },
      {
        "command": "denpex.compareLogs",
        "title": "Denpex: Compare Failed Log with Baseline Log (Diff)"
      }
    ],
    "keybindings": [
      {
        "command": "denpex.diagnoseClipboard",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "denpex.diagnoseSelection",
          "when": "editorHasSelection",
          "group": "navigation@100"
        }
      ],
      "terminal/context": [
        {
          "command": "denpex.diagnoseLastFailure",
          "group": "navigation@100"
        }
      ],
      "editor/title": [
        {
          "command": "denpex.diagnoseCurrentEditor",
          "when": "resourceExtname == .log || resourceExtname == .out || denpex.tracebackOpen",
          "group": "navigation@100"
        }
      ],
      "view/title": [
        {
          "command": "denpex.diagnoseCurrentLogs",
          "when": "view == denpex.sidebar",
          "group": "navigation@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "denpex",
          "title": "Denpex",
          "icon": "media/denpex.svg"
        }
      ]
    },
    "views": {
      "denpex": [
        {
          "id": "denpex.sidebar",
          "name": "GPU/ML Diagnostics",
          "type": "webview"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "denpex.firstDiagnosis",
        "title": "Trace the first failure in a sample NCCL hang",
        "description": "Diagnose a realistic NCCL cascade locally, inspect patient zero and the evidence-specific verification step, then try your own log.",
        "steps": [
          {
            "id": "denpex.firstDiagnosis.runSample",
            "title": "1. Diagnose a sample NCCL hang",
            "description": "Run a realistic rank-local OOM that turns into an NCCL watchdog cascade. No account or upload.\n[Diagnose the sample](command:denpex.sample.ncclOom)",
            "media": {
              "markdown": "walkthroughs/01-diagnose.md"
            },
            "completionEvents": [
              "onCommand:denpex.sample.ncclOom"
            ]
          },
          {
            "id": "denpex.firstDiagnosis.seeCausality",
            "title": "2. See the initiating rank and collateral victims",
            "description": "Separate the initiating failure from ranks that timed out later.\n[Show the causal chain](command:denpex.walkthrough.inspectCausality)",
            "media": {
              "markdown": "walkthroughs/02-causality.md"
            },
            "completionEvents": [
              "onCommand:denpex.walkthrough.inspectCausality"
            ]
          },
          {
            "id": "denpex.firstDiagnosis.inspectFix",
            "title": "3. Inspect the fix and verification step",
            "description": "Review the suggested fix and verification before changing anything.\n[Show the fix and verification](command:denpex.walkthrough.inspectFix)",
            "media": {
              "markdown": "walkthroughs/03-fix.md"
            },
            "completionEvents": [
              "onCommand:denpex.walkthrough.inspectFix"
            ]
          },
          {
            "id": "denpex.firstDiagnosis.ownLog",
            "title": "4. Try one of your own logs",
            "description": "Select a traceback in your editor, then diagnose it locally.\n[Diagnose selected text](command:denpex.diagnoseSelection)",
            "media": {
              "markdown": "walkthroughs/04-own-log.md"
            },
            "completionEvents": [
              "onContext:denpex.ownLogDiagnosed"
            ]
          },
          {
            "id": "denpex.firstDiagnosis.trial",
            "title": "5. Optional: request a 30-day Team trial",
            "description": "Local diagnosis stays free. For optional cloud access, request a trial with your work email, activate it, then connect.\n[Request a Team trial](command:denpex.startInEditorTrial)\n[Connect an existing eligible account](command:denpex.connectAccount)",
            "media": {
              "markdown": "walkthroughs/05-trial.md"
            },
            "completionEvents": [
              "onCommand:denpex.startInEditorTrial"
            ]
          }
        ]
      }
    ],
    "configuration": {
      "title": "Denpex",
      "properties": {
        "denpex.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python 3 executable for read-only local GPU artifact inspection. No shell command arguments."
        },
        "denpex.apiBase": {
          "type": "string",
          "default": "https://api.denpex.com",
          "markdownDescription": "Denpex API base URL. Only change this for staging or an on-prem/air-gapped deployment.",
          "order": 1
        },
        "denpex.predictive.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Watch terminal output of training runs for high-risk signals (NCCL retries, Xid/ECC events, loss spikes) and offer an immediate local diagnosis. Detection is fully local, *Diagnose Now* also runs locally unless you separately choose cloud reasoning.",
          "order": 3
        },
        "denpex.predictive.notifyCooldownMinutes": {
          "type": "number",
          "default": 10,
          "description": "Minimum minutes between pre-crash warnings.",
          "order": 4
        },
        "denpex.remediation.confirmBeforeRun": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before Denpex runs any fix command in a terminal.",
          "order": 5
        },
        "denpex.remediation.restartCommand": {
          "type": "string",
          "default": "",
          "description": "Command used by the [Restart from Checkpoint] button (e.g. 'sbatch resume_training.sh'). You'll be prompted on first use if empty.",
          "order": 6
        },
        "denpex.engine": {
          "type": "string",
          "enum": [
            "auto",
            "local",
            "cloud"
          ],
          "enumDescriptions": [
            "Local-first default (instant, unlimited, offline). Offer one immediate cloud deep reasoning pass for a complex failure; further cloud use needs an account or browser check.",
            "Local only. Unlimited and offline. Nothing ever leaves this machine.",
            "Always use the cloud engine. Uses your plan quota or free cloud passes."
          ],
          "default": "auto",
          "markdownDescription": "Which engine answers a diagnose command. **auto** is local-first default (instant, unlimited, offline) with on-demand cloud passes; **local** is unlimited and offline; **cloud** uses cloud deep reasoning."
        },
        "denpex.cloud.autoEscalate": {
          "type": "boolean",
          "default": false,
          "description": "After a local diagnosis, automatically run cloud deep reasoning too (uses quota). Off by default so nothing leaves the machine without you asking."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node scripts/bundle-engine.js && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "bundle:engine": "node scripts/bundle-engine.js"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.93.0",
    "typescript": "^5.1.3"
  }
}
